{%- comment -%}
  Scent quiz (brand-agnostic engine).
  All questions, tags, products and default texts live in the JSON asset named in "Config file".
  Blocks override wording and images per answer / question / persona so they can be edited in the theme editor.
  Without JavaScript the quiz stays hidden and the rest of the page is untouched.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings.config_file | strip
  assign personas = section.blocks | where: 'type', 'persona'
-%}
{{ 'scent-quiz.css' | asset_url | stylesheet_tag }}
<div class="sq-section palette-{{ section.settings.color_palette }} module-color-palette" id="sq-{{ section.id }}">
  {%- if cfg != blank -%}
    <div class="sq" data-scent-quiz data-config="{{ cfg | asset_url }}" hidden>
      <script type="application/json" data-sq-overrides>
        {
          "settings": {
            "intro_kicker": {{ section.settings.intro_kicker | default: '' | json }},
            "intro_title": {{ section.settings.intro_title | default: '' | json }},
            "intro_text": {{ section.settings.intro_text | default: '' | json }},
            "start": {{ section.settings.start_label | default: '' | json }}
          },
          "blocks": [
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'question' -%}
                  {"id": {{ block.id | json }}, "type": "question", "q": {{ block.settings.question_id | default: '' | strip | json }}, "title": {{ block.settings.title | default: '' | json }}}
                {%- when 'answer' -%}
                  {"id": {{ block.id | json }}, "type": "answer", "q": {{ block.settings.question_id | default: '' | strip | json }}, "a": {{ block.settings.answer_id | default: '' | strip | json }}, "label": {{ block.settings.label | default: '' | json }},
                   "img": {%- if block.settings.image != blank -%}{"s": {{ block.settings.image | image_url: width: 600 | json }}, "l": {{ block.settings.image | image_url: width: 900 | json }}, "alt": {{ block.settings.image.alt | default: block.settings.label | default: '' | json }}}{%- else -%}null{%- endif -%}}
                {%- when 'persona' -%}
                  {"id": {{ block.id | json }}, "type": "persona", "key": {{ block.settings.persona_key | default: '' | strip | json }}, "name": {{ block.settings.name | default: '' | json }}, "line": {{ block.settings.line | default: '' | json }}}
              {%- endcase -%}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
      <div class="sq__app" data-sq-app aria-live="polite"></div>
    </div>
    {%- if request.design_mode -%}
      {%- for block in section.blocks -%}{%- unless block.type == 'persona' -%}<span class="sq-anchor" {{ block.shopify_attributes }}></span>{%- endunless -%}{%- endfor -%}
    {%- endif -%}
  {%- elsif request.design_mode -%}
    <p class="sq-editor-note">Scent quiz: enter the config file name (for example scent-quiz-brand.json) in the section settings.</p>
  {%- endif -%}

  {%- if section.settings.show_personas and personas.size > 0 -%}
    <details class="sq-personas">
      <summary><h2 class="sq-personas__title">{{ section.settings.personas_title | escape }}</h2></summary>
      {%- if section.settings.personas_intro != blank -%}<p class="sq-personas__intro">{{ section.settings.personas_intro | escape }}</p>{%- endif -%}
      <ul class="sq-personas__list">
        {%- for block in personas -%}
          <li {{ block.shopify_attributes }}>
            <h3>{{ block.settings.name | escape }}</h3>
            <p>{{ block.settings.line | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </details>
  {%- endif -%}
</div>
<script src="{{ 'scent-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scent quiz",
  "tag": "section",
  "class": "shopify-section-scent-quiz",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "config_file", "label": "Config file (theme asset)", "info": "JSON asset with questions, scoring and catalog, e.g. scent-quiz-brand.json" },
    {
      "type": "select", "id": "color_palette", "label": "Color scheme", "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" }, { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }, { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }, { "value": "scheme-6", "label": "Scheme 6" },
        { "value": "scheme-7", "label": "Scheme 7" }, { "value": "scheme-8", "label": "Scheme 8" }
      ]
    },
    { "type": "header", "content": "Intro (leave blank to use the config file)" },
    { "type": "text", "id": "intro_kicker", "label": "Small line above the title" },
    { "type": "text", "id": "intro_title", "label": "Title" },
    { "type": "textarea", "id": "intro_text", "label": "Text" },
    { "type": "text", "id": "start_label", "label": "Start button" },
    { "type": "header", "content": "Persona list (static text for search engines)" },
    { "type": "checkbox", "id": "show_personas", "label": "Show persona list below the quiz", "default": true },
    { "type": "text", "id": "personas_title", "label": "List title", "default": "All scent personas" },
    { "type": "textarea", "id": "personas_intro", "label": "List intro" }
  ],
  "blocks": [
    {
      "type": "question", "name": "Question",
      "settings": [
        { "type": "text", "id": "question_id", "label": "Question id", "info": "Must match an id in the config file" },
        { "type": "text", "id": "title", "label": "Question text" }
      ]
    },
    {
      "type": "answer", "name": "Answer",
      "settings": [
        { "type": "text", "id": "question_id", "label": "Question id" },
        { "type": "text", "id": "answer_id", "label": "Answer id", "info": "Must match an answer id in the config file" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square images work best. Empty = default image from the config file." }
      ]
    },
    {
      "type": "persona", "name": "Persona",
      "settings": [
        { "type": "text", "id": "persona_key", "label": "Persona key", "info": "Must match a persona key in the config file" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "line", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Scent quiz" }]
}
{% endschema %}
