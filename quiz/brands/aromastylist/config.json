      { "key": "first-light", "name": "The First Light", "line": "Zest on warm skin. A bright, close scent for the first hour of the day, noticed only by whoever leans in." },
      { "key": "sunlit-signal", "name": "The Sunlit Signal", "line": "Citrus peel, green leaves and a clean trail that walks into the room a step behind you." },
      { "key": "bright-entrance", "name": "The Bright Entrance", "line": "Sparkling top notes with real staying power. You arrive and the whole room brightens a shade." },
      { "key": "quiet-signature", "name": "The Quiet Signature", "line": "Clean woods, cool herbs and a whisper of iris. Sharp, composed and kept to your own desk." },
      { "key": "sharp-edit", "name": "The Sharp Edit", "line": "Crisp aromatics over dry cedar. The scent of someone who answers emails in full sentences." },
      { "key": "boardroom-pull", "name": "The Boardroom Pull", "line": "Structured woods and cold spice with a trail that says the meeting starts when you sit down." },
      { "key": "skin-secret", "name": "The Skin Secret", "line": "Soft musk, warm petals and a trace of amber, made for the distance of a whisper." },
      { "key": "slow-burn", "name": "The Slow Burn", "line": "Rose, resin and something darker underneath. It lingers on a scarf long after you've left." },
      { "key": "after-hours-magnet", "name": "The After-Hours Magnet", "line": "Oud, amber and velvet florals that own the room after dark. Heads turn and nobody can say why." },
      { "key": "sweet-confidant", "name": "The Sweet Confidant", "line": "Vanilla, cream and a pinch of spice worn close. Dessert you keep to yourself." },
      { "key": "golden-hour-guest", "name": "The Golden Hour Guest", "line": "Juicy fruit, warm amber and a pop of fizz. You make any table feel like a party." },
      { "key": "grand-entrance", "name": "The Grand Entrance", "line": "Rum, praline, saffron and leather. Loud in the best way and still there at the last song." },
      { "key": "soft-landing", "name": "The Soft Landing", "line": "Lavender, sandalwood and clean musk. A Sunday with nowhere to be, bottled." },
      { "key": "cashmere-evening", "name": "The Cashmere Evening", "line": "Creamy woods and powdery vanilla that warm a room like a lamp turned low." },
      { "key": "clean-stride", "name": "The Clean Stride", "line": "Cool water, bright citrus and a snap of ginger. Fresh from the first step to the last." },
      { "key": "open-air", "name": "The Open Air", "line": "Sea salt, green leaves and wild herbs that trail behind you like wind off the water." },
      { "key": "still-point", "name": "The Still Point", "line": "Sandalwood, tea and a thread of incense. Close, unhurried and completely your own." },
      { "key": "temple-smoke", "name": "The Temple Smoke", "line": "Frankincense, myrrh and dry woods drifting through the room like the last minutes of a ritual." }
